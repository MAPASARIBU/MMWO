<!-- Add Non-WO Job Modal -->
<div id="nonWoModal" style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index: 10000;">
    <div class="card" style="margin: 30px auto; max-width: 600px; position: relative; max-height: 90vh; overflow-y: auto;">
        <% if (typeof isProcessing !== 'undefined' && isProcessing) { %>
            <h3>Add Non-WO / Processing Job</h3>
        <% } else { %>
            <h3>Add Non-WO / Fabrication Job</h3>
        <% } %>
        <form id="nonWoForm">
            <% if (typeof isProcessing !== 'undefined' && isProcessing) { %>
                <input type="hidden" id="is_bulk_processing" value="true">
                <% 
                   const processingStations = [
                       "FFB Reception", "Sterilizer", "Threshing", "Pressing", 
                       "Nut & Kernel", "Clarification", "Power Plant", "Steam Plant", 
                       "Kernel Bin Storage", "Water Treatment Plant", "CPO Washing Plant", "Effluent Pond"
                   ];
                %>
                <div style="max-height: 60vh; overflow-y: auto; margin-bottom: 15px;">
                    <table class="table" style="width: 100%; border-collapse: collapse;">
                        <thead style="position: sticky; top: 0; background: #f8fafc; z-index: 1;">
                            <tr>
                                <th style="width: 35%; padding: 8px; border: 1px solid #ddd;">Stasiun</th>
                                <th style="width: 65%; padding: 8px; border: 1px solid #ddd;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% processingStations.forEach((stName) => { 
                                const matchedStation = typeof stations !== 'undefined' ? stations.find(s => s.name.toLowerCase() === stName.toLowerCase()) : null;
                                const stId = matchedStation ? matchedStation.id : '';
                            %>
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #ddd; font-weight: 500;">
                                        <%= stName %>
                                        <input type="hidden" class="bulk-station-id" value="<%= stId %>">
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <input type="text" class="bulk-description form-control" placeholder="Isi deskripsi...">
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="form-group">
                    <label class="form-label">Category *</label>
                    <select name="category" class="form-control" required>
                        <option value="">-- Select Category --</option>
                        <option value="Mechanical">Mechanical</option>
                        <option value="Electrical">Electrical</option>
                        <option value="Fabrication">Fabrication</option>
                        <option value="Civil">Civil</option>
                        <option value="Instrument">Instrument</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Station *</label>
                    <select name="station_id" id="nonWoStationId" class="form-control" required onchange="filterNonWoEquipments(this.value)">
                        <option value="">-- Select Station --</option>
                        <% if(typeof stations !== 'undefined') { %>
                            <% stations.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Unit Mesin</label>
                    <select name="equipment_id" id="nonWoEquipmentId" class="form-control">
                        <option value="">-- Select Unit Mesin (Optional) --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Description *</label>
                    <textarea name="description" class="form-control" rows="3" required placeholder="Jelaskan detail pekerjaan..."></textarea>
                </div>
            <% } %>

            <% if (!(typeof isProcessing !== 'undefined' && isProcessing)) { %>
                <div class="form-group">
                    <label class="form-label">Assign Mechanics (Max 4)</label>
                    <div style="max-height: 150px; overflow-y: auto; border: 1px solid #eee; padding: 10px; border-radius: 4px;">
                        <% if(typeof workshopEmployees !== 'undefined' && workshopEmployees.length > 0) { %>
                            <% workshopEmployees.forEach(emp => { %>
                                <label style="display: block; margin-bottom: 8px; cursor: pointer;">
                                    <input type="checkbox" name="pic_ids" value="<%= emp.id %>" class="nonwo-pic-checkbox" onchange="checkNonWoMaxPics()">
                                    <%= emp.name %> <small class="text-secondary">(<%= emp.position || 'Mechanic' %>)</small>
                                </label>
                            <% }); %>
                        <% } else { %>
                            <div class="text-secondary text-center">No active labour employees found.</div>
                        <% } %>
                    </div>
                </div>
            <% } %>
            
            <div class="flex justify-between mt-4">
                <button type="button" onclick="closeNonWoModal()" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary" id="saveNonWoBtn">Add to Plan</button>
            </div>
        </form>
    </div>
</div>

<script>
    const nonWoStationsData = <%- JSON.stringify(typeof stations !== 'undefined' ? stations : []) %>;

    function filterNonWoEquipments(stationId) {
        const equipSelect = document.getElementById('nonWoEquipmentId');
        if (!equipSelect) return;
        
        equipSelect.innerHTML = '<option value="">-- Select Unit Mesin (Optional) --</option>';
        if (!stationId) return;

        const matchedSt = nonWoStationsData.find(s => s.id.toString() === stationId.toString());
        if (matchedSt && matchedSt.equipment && matchedSt.equipment.length > 0) {
            matchedSt.equipment.forEach(eq => {
                const opt = document.createElement('option');
                opt.value = eq.id;
                opt.textContent = eq.code ? `${eq.name} (${eq.code})` : eq.name;
                equipSelect.appendChild(opt);
            });
        }
    }

    function openNonWoModal() {
        document.getElementById('nonWoModal').style.display = 'block';
    }
    
    function closeNonWoModal() {
        document.getElementById('nonWoModal').style.display = 'none';
        document.getElementById('nonWoForm').reset();
        const equipSelect = document.getElementById('nonWoEquipmentId');
        if (equipSelect) {
            equipSelect.innerHTML = '<option value="">-- Select Unit Mesin (Optional) --</option>';
        }
    }

    function checkNonWoMaxPics() {
        const checkboxes = document.querySelectorAll('.nonwo-pic-checkbox:checked');
        const allCheckboxes = document.querySelectorAll('.nonwo-pic-checkbox');
        
        if (checkboxes.length >= 4) {
            allCheckboxes.forEach(cb => {
                if (!cb.checked) cb.disabled = true;
            });
        } else {
            allCheckboxes.forEach(cb => cb.disabled = false);
        }
    }

    document.getElementById('nonWoForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        let data = {};
        const isBulk = document.getElementById('is_bulk_processing');
        
        if (isBulk) {
            data.jobs = [];
            const stIds = document.querySelectorAll('.bulk-station-id');
            const descs = document.querySelectorAll('.bulk-description');
            
            for (let i = 0; i < stIds.length; i++) {
                const desc = descs[i].value.trim();
                const stId = stIds[i].value;
                if (desc !== "") {
                    if (!stId) {
                        alert("Stasiun tidak valid di database.");
                        return;
                    }
                    data.jobs.push({
                        category: "Processing",
                        station_id: stId,
                        description: desc
                    });
                }
            }
            if (data.jobs.length === 0) {
                alert("Harap isi setidaknya satu deskripsi pekerjaan.");
                return;
            }
        } else {
            const formData = new FormData(e.target);
            formData.forEach((value, key) => {
                if (key === 'pic_ids') {
                    if (!data[key]) data[key] = [];
                    data[key].push(value);
                } else {
                    data[key] = value;
                }
            });
        }

        document.getElementById('saveNonWoBtn').disabled = true;
        document.getElementById('saveNonWoBtn').innerText = "Saving...";

        try {
            const res = await fetch('/api/weekly-plan/non-wo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                window.location.reload();
            } else {
                const err = await res.json();
                alert(err.error || 'Terjadi kesalahan saat menambahkan Non-WO Job');
                document.getElementById('saveNonWoBtn').disabled = false;
                document.getElementById('saveNonWoBtn').innerText = "Add to Plan";
            }
        } catch (error) {
            console.error(error);
            alert('Error connecting to server.');
            document.getElementById('saveNonWoBtn').disabled = false;
            document.getElementById('saveNonWoBtn').innerText = "Add to Plan";
        }
    });
</script>
<!-- Sortir Modal -->
<div id="sortirModal" style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index: 10000;">
    <div class="card" style="margin: 50px auto; max-width: 400px; position: relative;">
        <h3>Program kerja harian</h3>
        <p class="text-secondary mb-3">Pilih tanggal untuk program kerja ini.</p>
        <div class="form-group">
            <label class="form-label">Tanggal Program *</label>
            <input type="date" id="sortirDate" class="form-control" required>
        </div>
        <div class="flex justify-between mt-4">
            <button type="button" onclick="closeSortirModal()" class="btn btn-secondary">Batal</button>
            <button type="button" class="btn btn-primary" onclick="submitSortir()">OK</button>
        </div>
    </div>
</div>

<script>
    function openSortirModal() {
        // Validate at least one WO is checked
        const checkboxes = document.querySelectorAll('input[name="wo_ids[]"]:checked');
        if (checkboxes.length === 0) {
            alert("Pilih minimal satu Work Order untuk disortir.");
            return;
        }
        document.getElementById('sortirDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('sortirModal').style.display = 'block';
    }
    
    function closeSortirModal() {
        document.getElementById('sortirModal').style.display = 'none';
    }

    function submitSortir() {
        const dateVal = document.getElementById('sortirDate').value;
        if (!dateVal) {
            alert("Tanggal Program harus diisi.");
            return;
        }

        // We need to submit the form but include the selected date as planned_week and planned_day.
        // Or we can dynamically append hidden inputs to the main form and submit it.
        const form = document.querySelector('form[action="/api/weekly-plan/bulk"]');
        
        // Remove existing planned_week and planned_day if they exist
        const oldWeek = form.querySelector('input[name="planned_week"]');
        if (oldWeek) oldWeek.remove();
        const oldDay = form.querySelector('input[name="planned_day"]');
        if (oldDay) oldDay.remove();

        const getISOWeekString = (dStr) => {
            const date = new Date(dStr);
            const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
            const dayNum = d.getUTCDay() || 7;
            d.setUTCDate(d.getUTCDate() + 4 - dayNum);
            const year = d.getUTCFullYear();
            const weekNo = Math.ceil((((d - new Date(Date.UTC(year, 0, 1))) / 86400000) + 1) / 7);
            return `${year}-W${String(weekNo).padStart(2, '0')}`;
        };

        const plannedWeekInput = document.createElement('input');
        plannedWeekInput.type = 'hidden';
        plannedWeekInput.name = 'planned_week';
        plannedWeekInput.value = getISOWeekString(dateVal); // Store ISO week

        const plannedDayInput = document.createElement('input');
        plannedDayInput.type = 'hidden';
        plannedDayInput.name = 'planned_day';
        plannedDayInput.value = dateVal; // Store the exact Date

        form.appendChild(plannedWeekInput);
        form.appendChild(plannedDayInput);

        closeSortirModal();
        form.submit();
    }
</script>
<!-- Filter Modal -->
<div id="filterModal" style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index: 10000;">
    <div class="card" style="margin: 50px auto; max-width: 500px; position: relative;">
        <h3>Search & Filter WO</h3>
        <form action="<%= typeof isProcessing !== 'undefined' && isProcessing ? '/weekly-plan/processing' : (typeof isCivil !== 'undefined' && isCivil ? '/weekly-plan/civil' : (typeof isOffice !== 'undefined' && isOffice ? '/weekly-plan/office' : '/weekly-plan')) %>" method="GET">
            <input type="hidden" name="week" value="<%= query.week || '' %>">
            
            <div class="form-group">
                <label>Date Range (WO Created Date)</label>
                <div class="flex gap-2 items-center">
                    <input type="date" name="candidateStartDate" class="form-control" value="<%= query.candidateStartDate || '' %>" required>
                    <span>to</span>
                    <input type="date" name="candidateEndDate" class="form-control" value="<%= query.candidateEndDate || '' %>" required>
                </div>
            </div>

            <div class="form-group">
                <label>Stations</label>
                <div style="max-height: 250px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; border-radius: 4px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 8px; border-bottom: 1px solid #eee; padding-bottom: 8px;">
                        <input type="checkbox" id="selectAllStations" onclick="toggleAllStations(this)"> Pilih Semua Stasiun
                    </label>
                    <% if(typeof stations !== 'undefined') { %>
                        <% stations.forEach(s => { 
                            let isChecked = false;
                            if (query.candidateStations) {
                                if (Array.isArray(query.candidateStations)) {
                                    isChecked = query.candidateStations.includes(s.id.toString());
                                } else {
                                    isChecked = query.candidateStations === s.id.toString();
                                }
                            }
                        %>
                            <label style="display: block; margin-bottom: 5px; cursor: pointer;">
                                <input type="checkbox" name="candidateStations" value="<%= s.id %>" class="station-checkbox" <%= isChecked ? 'checked' : '' %>>
                                <%= s.name %>
                            </label>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" onclick="closeFilterModal()">Batal / No</button>
                <button type="submit" class="btn btn-primary">OK</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openFilterModal() { document.getElementById('filterModal').style.display = 'block'; }
    function closeFilterModal() { document.getElementById('filterModal').style.display = 'none'; }
    function toggleAllStations(source) {
        let checkboxes = document.querySelectorAll('.station-checkbox');
        for(let i=0, n=checkboxes.length; i<n; i++) {
            checkboxes[i].checked = source.checked;
        }
    }
</script>

<!-- Modal Drilldown for Monthly Monitoring Order -->
<div id="monOrderDrilldownModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 10050; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
    <div class="card" style="width: 900px; max-width: 95%; max-height: 85vh; background: #ffffff; border-radius: 10px; padding: 20px; margin: auto; display: flex; flex-direction: column; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);">
        <!-- Modal Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 15px;">
            <div>
                <h4 id="drilldownModalTitle" style="margin: 0; color: #1e293b; font-size: 1.15rem; font-weight: 700;">
                    Detail Work Order
                </h4>
                <span id="drilldownModalSubtitle" style="font-size: 0.8rem; color: #64748b;">Daftar seluruh order pada stasiun dan periode ini</span>
            </div>
            <button type="button" onclick="closeMonthlyOrderDrilldown()" style="background: none; border: none; font-size: 1.5rem; color: #94a3b8; cursor: pointer; padding: 0 6px;" class="hover:text-red-500">&times;</button>
        </div>

        <!-- Filter in Modal -->
        <div style="margin-bottom: 12px;">
            <input type="text" id="drilldownSearchInput" class="form-control" placeholder="Cari nomor WO, unit mesin, PIC, deskripsi..." oninput="filterDrilldownTable()" style="font-size: 0.85rem; padding: 6px 12px;">
        </div>

        <!-- Table Container -->
        <div class="table-responsive" style="flex: 1; overflow-y: auto; max-height: 55vh; border: 1px solid #e2e8f0; border-radius: 6px;">
            <table class="table table-sm table-hover" id="drilldownTable" style="font-size: 0.82rem; margin: 0;">
                <thead style="position: sticky; top: 0; background: #1e293b; color: #ffffff; z-index: 5;">
                    <tr>
                        <th style="width: 35px; text-align: center; color: white;">NO</th>
                        <th style="width: 135px; color: white;">WO No</th>
                        <th style="width: 85px; color: white;">Tanggal</th>
                        <th style="width: 125px; color: white;">Unit Mesin</th>
                        <th style="width: 90px; color: white;">Kategori</th>
                        <th style="width: 105px; color: white;">Type Kerusakan</th>
                        <th style="color: white; min-width: 180px;">Keterangan Pekerjaan</th>
                        <th style="width: 105px; color: white;">PIC</th>
                        <th style="width: 85px; text-align: center; color: white;">Status</th>
                    </tr>
                </thead>
                <tbody id="drilldownTableBody">
                    <!-- Populated dynamically via JS -->
                </tbody>
            </table>
        </div>

        <!-- Modal Footer -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 15px;">
            <span id="drilldownCountLabel" style="font-size: 0.8rem; font-weight: 600; color: #475569;">Total: 0 WO</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeMonthlyOrderDrilldown()">Tutup</button>
        </div>
    </div>
</div>

<script>
    const monthlyWosData = <%- JSON.stringify(typeof wos !== 'undefined' && wos ? wos : []) %>;
    const monthlyMatrixData = <%- JSON.stringify(typeof monthlyOrderMatrix !== 'undefined' ? monthlyOrderMatrix : []) %>;
    const monthlyTotalsData = <%- JSON.stringify(typeof monthlyOrderTotals !== 'undefined' ? monthlyOrderTotals : []) %>;
    let currentDrilldownWos = [];

    function toggleDamageTypeView(view) {
        const chartEl = document.getElementById('damageTypeChartView');
        const tableEl = document.getElementById('damageTypeTableView');
        const btnChart = document.getElementById('btnViewStackedChart');
        const btnTable = document.getElementById('btnViewTrendTable');

        if (view === 'chart') {
            if (chartEl) chartEl.style.display = 'block';
            if (tableEl) tableEl.style.display = 'none';
            if (btnChart) {
                btnChart.className = 'btn btn-primary btn-sm';
            }
            if (btnTable) {
                btnTable.className = 'btn btn-outline-secondary btn-sm';
            }
        } else {
            if (chartEl) chartEl.style.display = 'none';
            if (tableEl) tableEl.style.display = 'block';
            if (btnChart) {
                btnChart.className = 'btn btn-outline-secondary btn-sm';
            }
            if (btnTable) {
                btnTable.className = 'btn btn-primary btn-sm';
            }
        }
    }

    function switchCategoryTab(tabName) {
        const currentActiveTab = '<%= typeof activeTab !== "undefined" ? activeTab : "plan" %>';
        if (tabName !== currentActiveTab) {
            const url = new URL(window.location.href);
            url.searchParams.set('tab', tabName);
            window.location.href = url.toString();
            return;
        }

        const tabPlanBtn = document.getElementById('cat-tab-btn-plan');
        const tabUpdateBtn = document.getElementById('cat-tab-btn-update');
        const tabMonBtn = document.getElementById('cat-tab-btn-monitoring');
        const tabMonthlyOrdersBtn = document.getElementById('cat-tab-btn-monthly-orders');
        const tabMonthlyBtn = document.getElementById('cat-tab-btn-monthly-plan');
        const tabAnalyticsBtn = document.getElementById('cat-tab-btn-analytics');

        const contentPlan = document.getElementById('cat-content-plan');
        const contentUpdate = document.getElementById('cat-content-update');
        const contentMon = document.getElementById('cat-content-monitoring');
        const contentMonthlyOrders = document.getElementById('cat-content-monthly-orders');
        const contentMonthly = document.getElementById('cat-content-monthly-plan');
        const contentAnalytics = document.getElementById('cat-content-analytics');

        // Reset all buttons
        [tabPlanBtn, tabUpdateBtn, tabMonBtn, tabMonthlyOrdersBtn, tabMonthlyBtn, tabAnalyticsBtn].forEach(btn => {
            if (btn) {
                btn.style.borderBottom = '3px solid transparent';
                btn.style.color = '#64748b';
                btn.style.fontWeight = '500';
            }
        });

        // Hide all contents
        if (contentPlan) contentPlan.style.display = 'none';
        if (contentUpdate) contentUpdate.style.display = 'none';
        if (contentMon) contentMon.style.display = 'none';
        if (contentMonthlyOrders) contentMonthlyOrders.style.display = 'none';
        if (contentMonthly) contentMonthly.style.display = 'none';
        if (contentAnalytics) contentAnalytics.style.display = 'none';

        if (tabName === 'plan') {
            if (tabPlanBtn) {
                tabPlanBtn.style.borderBottom = '3px solid #2563eb';
                tabPlanBtn.style.color = '#2563eb';
                tabPlanBtn.style.fontWeight = '600';
            }
            if (contentPlan) contentPlan.style.display = 'block';
        } else if (tabName === 'update') {
            if (tabUpdateBtn) {
                tabUpdateBtn.style.borderBottom = '3px solid #2563eb';
                tabUpdateBtn.style.color = '#2563eb';
                tabUpdateBtn.style.fontWeight = '600';
            }
            if (contentUpdate) contentUpdate.style.display = 'block';
            filterUpdateTable();
        } else if (tabName === 'monitoring') {
            if (tabMonBtn) {
                tabMonBtn.style.borderBottom = '3px solid #2563eb';
                tabMonBtn.style.color = '#2563eb';
                tabMonBtn.style.fontWeight = '600';
            }
            if (contentMon) contentMon.style.display = 'block';
        } else if (tabName === 'monthly-monitoring-orders') {
            if (tabMonthlyOrdersBtn) {
                tabMonthlyOrdersBtn.style.borderBottom = '3px solid #2563eb';
                tabMonthlyOrdersBtn.style.color = '#2563eb';
                tabMonthlyOrdersBtn.style.fontWeight = '600';
            }
            if (contentMonthlyOrders) contentMonthlyOrders.style.display = 'block';
        } else if (tabName === 'monthly-plan') {
            if (tabMonthlyBtn) {
                tabMonthlyBtn.style.borderBottom = '3px solid #2563eb';
                tabMonthlyBtn.style.color = '#2563eb';
                tabMonthlyBtn.style.fontWeight = '600';
            }
            if (contentMonthly) contentMonthly.style.display = 'block';
        } else if (tabName === 'analytics') {
            if (tabAnalyticsBtn) {
                tabAnalyticsBtn.style.borderBottom = '3px solid #2563eb';
                tabAnalyticsBtn.style.color = '#2563eb';
                tabAnalyticsBtn.style.fontWeight = '600';
            }
            if (contentAnalytics) contentAnalytics.style.display = 'block';
        }
    }

    // Auto-select tab based on URL query parameter or controller activeTab
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab') || '<%= typeof activeTab !== "undefined" ? activeTab : "plan" %>';
        if (['monitoring', 'update', 'monthly-monitoring-orders', 'monthly-plan', 'analytics'].includes(tabParam)) {
            switchCategoryTab(tabParam);
        }
    });

    // Drilldown Modal Opener Functions for Monthly Monitoring Order
    function openMonthlyCellDrilldown(rowIdx, monthIdx) {
        if (!monthlyMatrixData || !monthlyMatrixData[rowIdx] || !monthlyMatrixData[rowIdx].months || !monthlyMatrixData[rowIdx].months[monthIdx]) return;
        const row = monthlyMatrixData[rowIdx];
        const m = row.months[monthIdx];
        const year = '<%= typeof monOrderYear !== "undefined" ? monOrderYear : "" %>';
        showMonthlyOrderDrilldown(row.stationName, m.monthFullName, year, m.wos);
    }

    function openMonthlySummaryDrilldown(monthIdx) {
        if (!monthlyTotalsData || !monthlyTotalsData[monthIdx]) return;
        const m = monthlyTotalsData[monthIdx];
        const year = '<%= typeof monOrderYear !== "undefined" ? monOrderYear : "" %>';
        showMonthlyOrderDrilldown('Semua Stasiun', m.monthFullName, year, m.wos);
    }

    function showMonthlyOrderDrilldown(stationName, monthName, year, wosEncoded) {
        let wos = [];
        if (typeof wosEncoded === 'string') {
            try {
                wos = JSON.parse(decodeURIComponent(wosEncoded));
            } catch(e) {
                console.error("Failed to parse drilldown WOs", e);
            }
        } else if (Array.isArray(wosEncoded)) {
            wos = wosEncoded;
        }

        currentDrilldownWos = wos;

        const titleEl = document.getElementById('drilldownModalTitle');
        const subtitleEl = document.getElementById('drilldownModalSubtitle');
        const searchInput = document.getElementById('drilldownSearchInput');
        if (titleEl) titleEl.innerHTML = `<i class="fas fa-list-check text-blue-600 mr-2"></i> ${stationName} &bull; ${monthName} ${year}`;
        if (subtitleEl) subtitleEl.innerText = `Menampilkan ${wos.length} Work Order yang tercatat pada periode ini`;
        if (searchInput) searchInput.value = '';

        renderDrilldownRows(wos);

        const modal = document.getElementById('monOrderDrilldownModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeMonthlyOrderDrilldown() {
        const modal = document.getElementById('monOrderDrilldownModal');
        if (modal) modal.style.display = 'none';
    }

    function renderDrilldownRows(wos) {
        const tbody = document.getElementById('drilldownTableBody');
        const countLabel = document.getElementById('drilldownCountLabel');
        if (!tbody) return;

        tbody.innerHTML = '';
        if (countLabel) countLabel.innerText = `Total: ${wos.length} WO`;

        if (!wos || wos.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">Tidak ada Work Order pada periode ini.</td></tr>';
            return;
        }

        wos.forEach((wo, idx) => {
            const isClosed = wo.status === 'CLOSED' || wo.status === 'COMPLETED';
            const isInProg = wo.status === 'IN_PROGRESS';
            const statusBg = isClosed ? '#10b981' : (isInProg ? '#f59e0b' : '#3b82f6');

            const t = (wo.type || '').trim();
            let typeBadgeBg = '#eff6ff';
            let typeBadgeColor = '#1d4ed8';
            let typeBorder = '#bfdbfe';
            let typeIcon = 'fas fa-shield-halved';

            if (t === 'Breakdown' || t === 'Corrective') {
                typeBadgeBg = '#fef2f2';
                typeBadgeColor = '#b91c1c';
                typeBorder = '#fecaca';
                typeIcon = 'fas fa-bolt';
            } else if (t === 'Improvement') {
                typeBadgeBg = '#f5f3ff';
                typeBadgeColor = '#6d28d9';
                typeBorder = '#ddd6fe';
                typeIcon = 'fas fa-rocket';
            } else if (t === 'Safety') {
                typeBadgeBg = '#fffbeb';
                typeBadgeColor = '#b45309';
                typeBorder = '#fde68a';
                typeIcon = 'fas fa-person-shelter';
            } else if (t !== 'Preventive') {
                typeBadgeBg = '#f8fafc';
                typeBadgeColor = '#475569';
                typeBorder = '#e2e8f0';
                typeIcon = 'fas fa-gears';
            }

            const tr = document.createElement('tr');
            tr.className = 'drilldown-row';
            tr.setAttribute('data-search', `${wo.wo_no} ${wo.equipment_name || ''} ${wo.category || ''} ${wo.type || ''} ${wo.description || ''} ${wo.pic_name || ''} ${wo.status || ''}`.toLowerCase());
            
            tr.innerHTML = `
                <td style="text-align: center; font-weight: 500;">${idx + 1}</td>
                <td>
                    <a href="/work-orders/${wo.id}" target="_blank" style="color: #2563eb; font-weight: 700; text-decoration: none;" class="hover:underline">
                        ${wo.wo_no}
                    </a>
                </td>
                <td>${wo.formatted_date || '-'}</td>
                <td style="font-weight: 600; color: #1e293b;">${wo.equipment_name || '-'}</td>
                <td><span class="badge" style="background: #f1f5f9; color: #475569; font-size: 0.72rem; border: 1px solid #cbd5e1;">${wo.category || '-'}</span></td>
                <td>
                    <span class="badge" style="background: ${typeBadgeBg}; color: ${typeBadgeColor}; border: 1px solid ${typeBorder}; font-size: 0.72rem; font-weight: 700;">
                        <i class="${typeIcon} mr-1"></i>${wo.type || 'Preventive'}
                    </span>
                </td>
                <td style="white-space: normal; max-width: 260px;">${wo.description || '-'}</td>
                <td style="font-size: 0.8rem; font-weight: 500;">${wo.pic_name || '-'}</td>
                <td style="text-align: center;">
                    <span class="badge" style="background: ${statusBg}; color: white; font-size: 0.72rem; padding: 3px 6px; border-radius: 4px; font-weight: 600;">
                        ${wo.status || '-'}
                    </span>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function filterDrilldownTable() {
        const query = (document.getElementById('drilldownSearchInput')?.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.drilldown-row');
        let matchCount = 0;

        rows.forEach(r => {
            const text = r.getAttribute('data-search') || '';
            if (!query || text.includes(query)) {
                r.style.display = '';
                matchCount++;
            } else {
                r.style.display = 'none';
            }
        });

        const countLabel = document.getElementById('drilldownCountLabel');
        if (countLabel) countLabel.innerText = `Menampilkan ${matchCount} dari ${currentDrilldownWos.length} WO`;
    }

    function exportMonthlyOrderCsv() {
        const table = document.getElementById('monthlyOrderMatrixTable');
        if (!table) return;

        let csv = [];
        const rows = table.querySelectorAll('tr');
        
        rows.forEach(row => {
            const cols = row.querySelectorAll('th, td');
            let rowData = [];
            cols.forEach(col => {
                let text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/\s+/g, ' ').trim();
                text = text.replace(/"/g, '""');
                rowData.push('"' + text + '"');
            });
            if (rowData.length > 0) csv.push(rowData.join(','));
        });

        const csvString = csv.join('\n');
        const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Monthly_Monitoring_Work_Order_${new Date().getFullYear()}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    function printMonthlyOrders() {
        window.print();
    }

    function switchDiagnosaPeriod(monthVal) {
        const selectMonth = document.getElementById('selectMonOrderMonth');
        if (selectMonth && selectMonth.form) {
            selectMonth.value = monthVal;
            selectMonth.form.submit();
        } else {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('tab', 'monthly-monitoring-orders');
            urlParams.set('monOrderMonth', monthVal);
            window.location.search = urlParams.toString();
        }
    }

    // Material Modal Scripts for Sub Sheet 4 (Monthly Plan)
    function openMaterialModal(woId, woNo) {
        document.getElementById('modalWoId').value = woId;
        document.getElementById('modalWoTitle').innerText = 'Materials for ' + woNo;
        renderMaterialList(woId);
        document.getElementById('materialModal').style.display = 'flex';
    }

    function closeMaterialModal() {
        document.getElementById('materialModal').style.display = 'none';
    }

    function renderMaterialList(woId) {
        const wo = monthlyWosData.find(w => w.id == woId);
        const tbody = document.getElementById('materialsList');
        tbody.innerHTML = '';

        if (!wo || !wo.monthly_materials || wo.monthly_materials.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted">Belum ada material yang ditambahkan.</td></tr>';
            return;
        }

        wo.monthly_materials.forEach(mat => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td style="text-align: center;">
                    <input type="checkbox" ${mat.is_complete ? 'checked' : ''} onchange="toggleMaterial('${woId}', '${mat.id}', this.checked)" style="width: 16px; height: 16px; cursor: pointer;">
                </td>
                <td style="${mat.is_complete ? 'text-decoration: line-through; color: #94a3b8;' : 'font-weight: 500;'}">${mat.material_name}</td>
                <td style="text-align: center; ${mat.is_complete ? 'text-decoration: line-through; color: #94a3b8;' : ''}">${mat.quantity}</td>
                <td style="text-align: center;">
                    <button type="button" class="btn btn-sm text-red-600" style="background: none; border: none; font-size: 0.9rem; cursor: pointer;" onclick="deleteMaterial('${woId}', '${mat.id}')">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    async function addMaterial(e) {
        e.preventDefault();
        const woId = document.getElementById('modalWoId').value;
        const name = document.getElementById('matName').value;
        const qty = document.getElementById('matQty').value;

        try {
            const res = await fetch(`/api/monthly-plan/${woId}/materials`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ material_name: name, quantity: qty })
            });
            const data = await res.json();
            if (data.success) {
                const wo = monthlyWosData.find(w => w.id == woId);
                if (wo) {
                    if (!wo.monthly_materials) wo.monthly_materials = [];
                    wo.monthly_materials.push(data.material);
                }
                document.getElementById('matName').value = '';
                document.getElementById('matQty').value = '1';
                renderMaterialList(woId);
            } else {
                alert('Gagal menambah material: ' + data.error);
            }
        } catch (err) {
            console.error(err);
            alert('Kesalahan koneksi saat menambah material.');
        }
    }

    async function toggleMaterial(woId, matId, isComplete) {
        try {
            const res = await fetch(`/api/monthly-plan/${woId}/materials/${matId}/toggle`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_complete: isComplete })
            });
            const data = await res.json();
            if (data.success) {
                const wo = monthlyWosData.find(w => w.id == woId);
                if (wo) {
                    const mat = wo.monthly_materials.find(m => m.id == matId);
                    if (mat) mat.is_complete = isComplete;
                }
                renderMaterialList(woId);

                if (data.allComplete) {
                    alert('Semua material sudah lengkap! WO ini telah selesai persiapan material.');
                    window.location.reload();
                }
            }
        } catch (err) {
            console.error(err);
            alert('Kesalahan koneksi saat mengupdate status material.');
        }
    }

    async function deleteMaterial(woId, matId) {
        if (!confirm('Hapus material ini?')) return;
        try {
            const res = await fetch(`/api/monthly-plan/materials/${matId}`, { method: 'DELETE' });
            if (res.ok) {
                const wo = monthlyWosData.find(w => w.id == woId);
                if (wo) {
                    wo.monthly_materials = wo.monthly_materials.filter(m => m.id != matId);
                }
                renderMaterialList(woId);
            }
        } catch (err) {
            console.error(err);
            alert('Kesalahan koneksi saat menghapus material.');
        }
    }

    function openPrintModal() {
        const modal = document.getElementById('printModal');
        if (modal) modal.style.display = 'flex';
    }

    function submitMonitoringPrint(e) {
        e.preventDefault();
        const start = document.getElementById('printStartDate').value;
        const end = document.getElementById('printEndDate').value;
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('startDate', start);
        urlParams.set('endDate', end);
        urlParams.set('tab', 'monitoring');
        urlParams.set('autoPrint', 'true');
        window.location.search = urlParams.toString();
    }

    // Auto print if requested
    <% if (typeof autoPrint !== 'undefined' && autoPrint) { %>
        window.addEventListener('load', function() {
            setTimeout(() => {
                window.print();
            }, 600);
        });
    <% } %>

    async function startMaintenanceWo(woId, woNo, el) {
        if (!confirm(`Mulai pekerjaan untuk WO ${woNo}?\nStatus WO akan diubah menjadi IN_PROGRESS.`)) {
            el.checked = false;
            return;
        }

        el.disabled = true;
        const row = el.closest('tr');
        const cbSelesai = row ? row.querySelector('.cb-selesai') : null;

        try {
            const res = await fetch(`/api/work-orders/${woId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'IN_PROGRESS' })
            });

            if (res.ok) {
                const statusBadge = document.getElementById(`status-badge-${woId}`);
                if (statusBadge) {
                    statusBadge.className = 'badge';
                    statusBadge.style.background = '#f59e0b';
                    statusBadge.style.color = '#ffffff';
                    statusBadge.innerText = 'IN_PROGRESS';
                }
                el.checked = true;
                el.disabled = true;
                if (cbSelesai) {
                    cbSelesai.disabled = false;
                    const parentLabel = cbSelesai.closest('label');
                    if (parentLabel) {
                        parentLabel.style.cursor = 'pointer';
                        parentLabel.style.color = '#16a34a';
                    }
                }
            } else {
                const err = await res.json();
                alert('Gagal update status: ' + (err.error || 'Terjadi kesalahan'));
                el.checked = false;
                el.disabled = false;
            }
        } catch (e) {
            console.error(e);
            alert('Terjadi kesalahan koneksi saat mengupdate status.');
            el.checked = false;
            el.disabled = false;
        }
    }

    async function closeWeeklyWo(woId, woNo, el, isMaint = false) {
        if (!confirm(`Tandai pekerjaan untuk WO ${woNo} sebagai SELESAI?\nStatus WO akan diubah menjadi CLOSED dan seluruh pilihan centang akan terkunci.`)) {
            el.checked = false;
            const row = el.closest('tr');
            if (row && !isMaint) {
                const radioBelum = row.querySelector('.radio-belum');
                if (radioBelum) radioBelum.checked = true;
            }
            return;
        }

        el.disabled = true;
        const row = el.closest('tr');
        const cbStart = row ? row.querySelector('.cb-start') : null;
        const radioBelum = row ? row.querySelector('.radio-belum') : null;
        if (cbStart) cbStart.disabled = true;
        if (radioBelum) radioBelum.disabled = true;

        try {
            const res = await fetch(`/api/work-orders/${woId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'CLOSED' })
            });

            if (res.ok) {
                const statusBadge = document.getElementById(`status-badge-${woId}`);
                if (statusBadge) {
                    statusBadge.className = 'badge';
                    statusBadge.style.background = '#10b981';
                    statusBadge.style.color = '#ffffff';
                    statusBadge.innerText = 'CLOSED';
                }
                el.checked = true;
                el.disabled = true;
                if (cbStart) {
                    cbStart.checked = true;
                    cbStart.disabled = true;
                }
                if (radioBelum) {
                    radioBelum.checked = false;
                    radioBelum.disabled = true;
                }
                if (row) {
                    row.setAttribute('data-status', 'SELESAI');
                }
            } else {
                const err = await res.json();
                alert('Gagal update status: ' + (err.error || 'Terjadi kesalahan'));
                el.checked = false;
                el.disabled = false;
                if (radioBelum) {
                    radioBelum.checked = true;
                    radioBelum.disabled = false;
                }
            }
        } catch (e) {
            console.error(e);
            alert('Terjadi kesalahan koneksi saat mengupdate status.');
            el.checked = false;
            el.disabled = false;
            if (radioBelum) {
                radioBelum.checked = true;
                radioBelum.disabled = false;
            }
        }
    }

    function filterUpdateTable() {
        const startDate = document.getElementById('updateStartDate') ? document.getElementById('updateStartDate').value : '';
        const endDate = document.getElementById('updateEndDate') ? document.getElementById('updateEndDate').value : '';
        const statusFilter = document.getElementById('updateStatusFilter') ? document.getElementById('updateStatusFilter').value : 'ALL';
        const searchText = (document.getElementById('updateSearchText') ? document.getElementById('updateSearchText').value : '').toLowerCase().trim();

        const rows = document.querySelectorAll('.cat-update-row');

        rows.forEach(row => {
            const rowDate = row.getAttribute('data-date') || '';
            const rowStatus = row.getAttribute('data-status') || '';
            const rowText = row.getAttribute('data-text') || '';

            let matchesDate = true;
            if (startDate && rowDate && rowDate < startDate) matchesDate = false;
            if (endDate && rowDate && rowDate > endDate) matchesDate = false;

            let matchesStatus = true;
            if (statusFilter !== 'ALL') {
                matchesStatus = (rowStatus === statusFilter);
            }

            let matchesSearch = true;
            if (searchText) {
                matchesSearch = rowText.includes(searchText);
            }

            if (matchesDate && matchesStatus && matchesSearch) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function resetUpdateFilters() {
        const s = document.getElementById('updateStartDate');
        const e = document.getElementById('updateEndDate');
        const sf = document.getElementById('updateStatusFilter');
        const st = document.getElementById('updateSearchText');
        if (s) s.value = '';
        if (e) e.value = '';
        if (sf) sf.value = 'ALL';
        if (st) st.value = '';
        filterUpdateTable();
    }
</script>
</div>