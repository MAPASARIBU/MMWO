<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof isProcessing !== 'undefined' && isProcessing ? 'Weekly Processing Plan' : (typeof isCivil !== 'undefined' && isCivil ? 'Weekly Civil Plan' : (typeof isOffice !== 'undefined' && isOffice ? 'Weekly Office Plan' : 'Weekly Maintenance Plan')) %> - <%= today %></title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            line-height: 1.4;
            max-width: 100%;
            margin: 0;
            padding: 10px;
        }

        .header {
            text-align: center;
            margin-bottom: 10px;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            margin-top: 0px;
        }

        .header h1 {
            margin: 0;
            font-size: 24px;
        }

        .header p {
            margin: 5px 0 0;
            color: #666;
        }

        .section {
            margin-bottom: 10px;
        }

        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
            border-left: 5px solid #007bff;
            padding-left: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 18px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #e9ecef;
            border-bottom: 2px solid #333;
            font-weight: bold;
            color: #495057;
        }

        tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        @media print {
            tr:nth-child(even) {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                background-color: #f2f2f2 !important;
            }

            th {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                background-color: #e9ecef !important;
            }
            body {
                padding: 0;
            }
            .no-print {
                display: none;
            }
            a {
                text-decoration: none;
                color: #333;
            }
        }

        .print-controls {
            margin-bottom: 20px;
            text-align: right;
        }

        .btn {
            display: inline-block;
            padding: 8px 16px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            border: none;
        }

        .btn-secondary {
            background-color: #6c757d;
        }

        .iso-header, .iso-footer {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            color: #000;
        }

        .iso-header td, .iso-footer td {
            border: 1px solid #000;
            padding: 5px 8px;
        }
        
        .iso-header {
            margin-bottom: 20px;
            border: 2px solid #000;
        }

        .iso-footer {
            margin-top: 30px;
            text-align: center;
            border: 2px solid #000;
        }

        .main-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 16px;
            color: #000;
            border: 1px solid #000;
        }

        .main-table th, .main-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

        .main-table th {
            background-color: #e9ecef;
            font-weight: bold;
            color: #000;
        }

        @page {
            size: A4 portrait;
            margin: 0;
        }

        @media print {
            body {
                padding: 1.5cm;
            }
            .main-table th {
                background-color: #e9ecef !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .iso-header, .iso-footer, .main-table {
                border-color: #000 !important;
            }
            .iso-header td, .iso-footer td, .main-table th, .main-table td {
                border-color: #000 !important;
            }
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="print-controls no-print" style="margin-bottom: 15px; text-align: right; display: flex; justify-content: flex-end; gap: 8px;">
        <button type="button" onclick="window.print()" class="btn" style="font-weight: 600; padding: 6px 14px; font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
            🖨️ Cetak Dokumen
        </button>
        <button type="button" onclick="handleClose()" class="btn btn-secondary" style="font-weight: 600; padding: 6px 14px; font-size: 13px;">
            Tutup
        </button>
    </div>

    <script>
        function handleClose() {
            if (window.parent && typeof window.parent.closeDailyPlanPreviewModal === 'function') {
                window.parent.closeDailyPlanPreviewModal();
            } else {
                window.close();
            }
        }
    </script>

    <!-- ISO HEADER -->
    <table class="iso-header">
        <tr>
            <td rowspan="4" style="width: 25%; text-align: center; vertical-align: middle;">
                <strong style="font-size: 18px;"><%= user.current_mill_name || 'PLANTATION MILL' %></strong>
            </td>
            <td rowspan="4" style="width: 50%; text-align: center; vertical-align: middle; font-size: 20px; font-weight: bold; text-transform: uppercase;">
                <%= typeof isProcessing !== 'undefined' && isProcessing ? 'Processing Weekly Plan' : (typeof isCivil !== 'undefined' && isCivil ? 'Civil Weekly Plan' : (typeof isOffice !== 'undefined' && isOffice ? 'Office Weekly Plan' : 'Maintenance Weekly Plan')) %>
            </td>
            <td style="width: 12%; font-weight: bold; font-size: 12px;">No. Dokumen</td>
            <td style="width: 13%; font-size: 12px;">: FM-<%= typeof isProcessing !== 'undefined' && isProcessing ? 'PRC' : (typeof isCivil !== 'undefined' && isCivil ? 'CIV' : (typeof isOffice !== 'undefined' && isOffice ? 'OFC' : 'MTC')) %>-01</td>
        </tr>
        <tr>
            <td style="font-weight: bold; font-size: 12px;">Revisi</td>
            <td style="font-size: 12px;">: 00</td>
        </tr>
        <tr>
            <td style="font-weight: bold; font-size: 12px;">Tanggal</td>
            <td style="font-size: 12px;">: <%= query.day || new Date().toISOString().split('T')[0] %></td>
        </tr>
        <tr>
            <td style="font-weight: bold; font-size: 12px;">Halaman</td>
            <td style="font-size: 12px;">: 1 dari 1</td>
        </tr>
    </table>

    <div class="section">
        <table class="main-table">
            <thead>
                <tr>
                    <th style="width: 20%; text-align: center;">Station</th>
                    <th style="width: 55%; text-align: center;">Description</th>
                    <th style="width: 25%; text-align: center;">PIC</th>
                </tr>
            </thead>
            <tbody>
                <% if (Object.keys(groupedPlans).length > 0) { %>
                    <% for (const category in groupedPlans) { %>
                        <tr style="background-color: #f8f9fa;">
                            <td colspan="3" style="font-weight: bold; font-size: 16px; text-transform: uppercase;">
                                KATEGORI: <%= category %>
                            </td>
                        </tr>
                        <% groupedPlans[category].forEach(plan => { %>
                            <tr>
                                <td><%= plan.wo.station ? plan.wo.station.name : '-' %></td>
                                <td><%= plan.wo.description %></td>
                                <td>
                                    <% if (plan.wo.pics && plan.wo.pics.length > 0) { %>
                                        <%= plan.wo.pics.map(p => p.name).join(', ') %>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 20px;">No planned work found matching the criteria.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- ISO FOOTER -->
    <table class="iso-footer">
        <tr>
            <td style="width: 33.33%; font-weight: bold; padding: 8px;">Dibuat Oleh,</td>
            <td style="width: 33.33%; font-weight: bold; padding: 8px;">Diperiksa Oleh,</td>
            <td style="width: 33.33%; font-weight: bold; padding: 8px;">Disetujui Oleh,</td>
        </tr>
        <tr>
            <td style="height: 80px; vertical-align: bottom; padding: 8px;">
                <u><%= user.name %></u><br>
                <%= user.role %>
            </td>
            <td style="height: 80px; vertical-align: bottom; padding: 8px;">
                <u>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u><br>
                Askep / Mill Manager
            </td>
            <td style="height: 80px; vertical-align: bottom; padding: 8px;">
                <u>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u><br>
                Senior Mill Manager
            </td>
        </tr>
    </table>
</body>

</html>
